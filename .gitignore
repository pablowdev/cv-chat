# Secretos y datos: nunca al repositorio
.env
*.env
!deploy/env.example
tools/rclone.conf
tools/*.log
tools/*estado*.json
haven-data/
caddy-data/
caddy-config/
backup-local/

# Logo de la pantalla de carga: propio de cada servidor
tools/puente/web/logo-carga.png
tools/puente/web/icono-notificacion.png

# Dependencias instaladas en el servidor (sharp)
tools/puente/vendor/

# Dibujos de las cartas del truco: propios de cada servidor
tools/puente/web/cartas/

# Tableros del Funball original: propios de cada servidor
tools/puente/funball-tableros.json
# Dibujos del Funball: propios de cada servidor
tools/puente/web/funball/

# Apps: instaladores, firma, iconos y lo que arma cada herramienta
tools/puente/web/descargas/
tools/puente/web/icono-mercado.webp
tools/puente/web/icono-juegos.webp
apps/**/node_modules/
apps/**/dist/
apps/**/build/
apps/**/.gradle/
apps/android/local.properties
apps/android/firma.properties
*.keystore
*.jks
apps/android/app/src/main/res/**/*.png
# Proyecto Gusanos: el codigo va al repositorio; los assets y la tapa son de cada servidor
tools/puente/web/gusanos/assets/
tools/puente/web/tapas/gusanos.jpg

# WORGS: los sonidos y los graficos de WA quedan solo en el servidor (assets de Team17, fuera del repositorio publico)
tools/puente/web/worgs/sonidos/
tools/puente/web/worgs/assets/
# WORGS: los mapas de Shopper de la comunidad (mascaras, imagenes originales y comunidad.json): solo en el servidor
tools/puente/web/worgs/comunidad/
