{
  "name": "cv-chat",
  "productName": "CV Chat",
  "version": "1.0.5",
  "description": "CV Chat, el chat de Circulo Vicioso",
  "author": "Circulo Vicioso",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "armar": "electron-builder --win nsis --x64",
    "tienda": "electron-builder --win appx --x64"
  },
  "build": {
    "appId": "club.circulovicioso.chat",
    "productName": "CV Chat",
    "copyright": "Circulo Vicioso",
    "files": [
      "main.js",
      "sin-notificaciones.js",
      "build/icon.png"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "CV Chat",
      "include": "instalador.nsh",
      "artifactName": "CV-Chat-Windows.exe"
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://chat.circulovicioso.club/puente/descargas/"
      }
    ],
    "appx": {
      "identityName": "PabloW.CVChat",
      "publisher": "CN=1AEF1706-B939-451A-BF37-168EB86AA9A2",
      "publisherDisplayName": "PabloW",
      "applicationId": "CVChat",
      "displayName": "CV Chat",
      "backgroundColor": "#211c1f",
      "languages": [
        "es-AR",
        "es-ES",
        "en-US"
      ],
      "artifactName": "CV-Chat-Store.appx",
      "minVersion": "10.0.19041.0",
      "customManifestPath": "appxmanifest.xml",
      "customExtensionsPath": "appx-inicio.xml",
      "maxVersionTested": "10.0.26100.0"
    }
  },
  "devDependencies": {
    "electron": "^37.2.0",
    "electron-builder": "^26.0.12"
  },
  "dependencies": {
    "electron-updater": "^6.6.2"
  }
}
