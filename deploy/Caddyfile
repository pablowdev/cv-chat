# Cabeceras de seguridad: siempre por https (HSTS, un año), sin adivinar el tipo de los archivos y
# sin decir que programa atiende. Con "?" solo se ponen si la app no las puso (cada una por
# separado: juntas, Caddy las pone solo si no falta ninguna)
(seguridad) {
	header ?Strict-Transport-Security "max-age=31536000"
	header ?X-Content-Type-Options "nosniff"
	header ?Referrer-Policy "strict-origin-when-cross-origin"
	header -Server
	header -X-Powered-By
}

chat.example.com {
	import seguridad
	encode gzip
	# BACITY (opcional): el juego de mundo abierto corre en su propio contenedor y queda en esta misma
	# direccion, bajo /bacity/ (la pagina y su conexion). Descomentar si se instala (ver deploy/env.example)
	# redir /bacity /bacity/ 308
	# handle /bacity/* {
	# 	reverse_proxy bacity:8787
	# }
	reverse_proxy haven:3000
}
